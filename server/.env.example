# Server Port (defaults to 5000 if unset)
PORT=5000

# MongoDB Connection String (Optional/Empty in Phase 1; required in Phase 2)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/hotelpro?retryWrites=true&w=majority

# JWT Authentication Secret (Must be at least 16 characters)
JWT_SECRET=hotelpro_development_jwt_secret_placeholder_key_2026

# Allowed CORS Origins (Comma-separated list of allowed web clients)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Administrator Provisioning Password (Required for controlled database seeding)
ADMIN_PASSWORD=your_secure_admin_password_here_min12

# Google OAuth 2.0 Client ID (Optional; set to activate Google Single Sign-On)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
